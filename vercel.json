{
  "redirects": [
    {
      "source": "/krejcirik-bazeny",
      "destination": "/krejcirik-bazeny/",
      "permanent": true
    },
    {
      "source": "/emoce",
      "destination": "/emoce/",
      "permanent": true
    },
    {
      "source": "/denisa-blaho",
      "destination": "/denisa-blaho/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/jednoduchy-web",
