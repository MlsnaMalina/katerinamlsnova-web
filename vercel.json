      "destination": "https://krejcirik-bazeny.vercel.app/:path*"
    },
    {
      "source": "/emoce/",
      "destination": "https://emocni-priserky.vercel.app/index.html"
    },
    {
      "source": "/emoce/:path*",
      "destination": "https://emocni-priserky.vercel.app/:path*"
    },
    {
      "source": "/denisa-blaho/",
      "destination": "https://denisa-blaho.vercel.app/index.html"
    },
    {
      "source": "/denisa-blaho/:path*",
      "destination": "https://denisa-blaho.vercel.app/:path*"
